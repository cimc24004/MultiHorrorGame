#!/bin/sh

# ファイルサイズの上限を設定 (100MB)
LIMIT_BYTES=104857600 # 100 * 1024 * 1024
LIMIT_MB=100

# ステージングされているファイル（これからコミットされるファイル）をチェック
git diff --cached --name-only --diff-filter=ACM | while read -r file; do
    # ファイルのサイズを取得
    size=$(git cat-file -p :0:"$file" | wc -c)

    # サイズが上限を超えていないかチェック
    if [ "$size" -gt "$LIMIT_BYTES" ]; then
        echo "🚨エラー: ファイルサイズが${LIMIT_MB}MBを超えています！"
        echo "  -> ファイル: $file"
        echo "  -> サイズ: $(echo "$size" | awk '{printf "%.2f MB", $1/1024/1024}')"
        echo "コミットを中断します。このファイルをコミット対象から外してください。"
        exit 1 # コミットを中断
    fi
done

# 問題がなければコミットを許可
exit 0
